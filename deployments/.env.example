# 容器编排使用的环境变量，复制为 deployments/.env 后填写。
# 该文件被根目录 .gitignore 忽略（deployments/.env），切勿提交真实凭据。

# ---------- 数据库 ----------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=prismgen
MYSQL_PASSWORD=replace_me_db_password
MYSQL_DATABASE=prismgen
# 初始化脚本创建的库若与上面不同，请一并调整
MYSQL_ROOT_PASSWORD=replace_me_root_password

# ---------- 会话 ----------
ACCESS_TOKEN_SECRET=replace_me_random_string
CORS_ORIGINS=https://your-domain.example

# ---------- 静帧模型（可选，留空则该通道不生效） ----------
PRISM_MODELHUB_KEY=
MODELHUB_BASE_URL=
MODELHUB_TIMEOUT_MS=120000

# ---------- 动态生成 ----------
MOTION_API_BASE=https://api-beijing.klingai.com
MOTION_CREATE_PATH=/v1/videos/image2video
MOTION_STATUS_PATH=/v1/videos/image2video
MOTION_KEY_ID=
MOTION_KEY_SECRET=
MOTION_GATE_LIMIT=20
# 公网回调地址，供生成完成后主动通知
MOTION_WEBHOOK_URL=

# ---------- 色板生成（可选） ----------
RASTER_API_HOST=https://visual.volcengineapi.com
RASTER_ACCESS_KEY_ID=
RASTER_SECRET_ACCESS_KEY=

# ---------- 出口代理（可选） ----------
OUTBOUND_PROXY_URL=

# ---------- 站点 ----------
# 宿主机访问端口，容器内固定监听 80
APP_PORT=8080
# 生成件与上传件的容器内路径，与 compose 的卷挂载保持一致
MEDIA_ROOT=/app/media
