# ---------- 接口进程 ----------
HTTP_PORT=7008
NODE_ENV=development

# 跨域白名单，逗号分隔；留空表示不限制
CORS_ORIGINS=http://localhost:5388

# 会话签名密钥，务必换成随机值
ACCESS_TOKEN_SECRET=replace_me_random_string

# ---------- 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_me_db_password
MYSQL_DATABASE=prismgen
MYSQL_POOL_SIZE=10

# 产物与上传件的落盘根目录，缺省为 server/media
# MEDIA_ROOT=/srv/prismgen/media

# ---------- 静帧模型（第三方生成接口，可选） ----------
PRISM_MODELHUB_KEY=replace_me_modelhub_key
# MODELHUB_BASE_URL=
# MODELHUB_TIMEOUT_MS=120000

# 访问不通时走本地代理
# OUTBOUND_PROXY_URL=http://127.0.0.1:7890

# ---------- 动态生成（图生视频接口） ----------
# AK/SK 不要提交真实值；允许带引号，读取时会自动剥掉
MOTION_KEY_ID=replace_me_motion_key_id
MOTION_KEY_SECRET=replace_me_motion_key_secret
MOTION_API_BASE=https://api-beijing.klingai.com
MOTION_CREATE_PATH=/v1/videos/image2video
MOTION_STATUS_PATH=/v1/videos/image2video
MOTION_STATUS_QUERY=task_id
# 公网可达时填写，用于接收生成回调
# MOTION_WEBHOOK_URL=https://your-domain.example/api/motion/webhook
# 排队上限，超出后返回 429
MOTION_GATE_LIMIT=20

# ---------- 色板生成（需要 AK/SK 签名的图像接口，可选） ----------
RASTER_API_HOST=https://visual.volcengineapi.com
RASTER_SUBMIT_ACTION=CVSync2AsyncSubmitTask
RASTER_POLL_ACTION=CVSync2AsyncGetResult
RASTER_SUBMIT_VERSION=2022-08-31
RASTER_POLL_VERSION=2022-08-31
RASTER_REGION=cn-north-1
RASTER_SERVICE=visual
RASTER_ACCESS_KEY_ID=replace_me_volc_access_key
RASTER_SECRET_ACCESS_KEY=replace_me_volc_secret_key
